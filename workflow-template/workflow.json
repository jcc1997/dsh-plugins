{
  "schemaVersion": 1,
  "name": "dsh-workflow-template",
  "description": "软件开发工作流配置样例:Backlog → RD → TD → UC → In Dev → 1st Review → Testing → 2nd review → Stage → Done(10 列 + 9 门禁 + workflow 模板)。导入后即可获得一套完整的带门禁研发流程。",
  "kanban": {
    "columns": [
      "Backlog",
      "RD",
      "TD",
      "UC",
      "In Dev",
      "1st Review",
      "Testing",
      "2nd review",
      "Stage",
      "Done"
    ],
    "gates": [
      {
        "name": "进入 RD 需建 workflow 分支",
        "on": "move",
        "to": "RD",
        "checker": {
          "type": "branch-linked"
        }
      },
      {
        "name": "RD 确认才能进 TD",
        "on": "move",
        "to": "TD",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "rd-confirmed"
            ]
          }
        }
      },
      {
        "name": "TD 确认才能进 UC",
        "on": "move",
        "to": "UC",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "td-confirmed"
            ]
          }
        }
      },
      {
        "name": "验收用例确认才能开发",
        "on": "move",
        "to": "In Dev",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "uc-confirmed"
            ]
          }
        }
      },
      {
        "name": "进入评审需关联 MR",
        "on": "move",
        "to": "1st Review",
        "checker": {
          "type": "mr-linked"
        }
      },
      {
        "name": "1st review 通过才能测试",
        "on": "move",
        "to": "Testing",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "review-1-done"
            ]
          }
        }
      },
      {
        "name": "Review pipeline 通过才能进 Testing",
        "on": "move",
        "to": "Testing",
        "checker": {
          "type": "pipeline",
          "config": {
            "pipelines": [
              "p-workflow-review"
            ]
          }
        }
      },
      {
        "name": "测试通过才能进 2nd review",
        "on": "move",
        "to": "2nd review",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "tests-passed"
            ]
          }
        }
      },
      {
        "name": "2nd review 通过才能 Stage",
        "on": "move",
        "to": "Stage",
        "checker": {
          "type": "tag-required",
          "config": {
            "tags": [
              "review-2-done"
            ]
          }
        }
      },
      {
        "name": "MR 已合并才能进 Done",
        "on": "move",
        "to": "Done",
        "checker": {
          "type": "mr-merged"
        }
      },
      {
        "name": "进入 In Dev 需建 workflow 分支",
        "on": "move",
        "to": "In Dev",
        "checker": {
          "type": "branch-linked",
          "config": {}
        }
      }
    ],
    "templates": [
      {
        "name": "workflow",
        "description": "标准开发工作流:Backlog→RD→TD→UC→In Dev→1st Review→Testing→2nd review→Stage→Done。进入下一列需过门禁;确认=打 confirm 标签。文档在 git 仓库 docs/<taskId>/ 随分支 MR 演进。",
        "tags": [
          "workflow",
          "default"
        ],
        "gates": [
          "进入 RD 需建 workflow 分支",
          "RD 确认才能进 TD",
          "TD 确认才能进 UC",
          "验收用例确认才能开发",
          "进入评审需关联 MR",
          "1st review 通过才能测试",
          "Review pipeline 通过才能进 Testing",
          "测试通过才能进 2nd review",
          "2nd review 通过才能 Stage",
          "MR 已合并才能进 Done"
        ]
      },
      {
        "name": "bug",
        "description": "Bug 处理轻量流程：Backlog→In Dev 直进（跳过 RD/TD/UC 文档确认，复现步骤+验收点写卡描述）；分支/MR 照建；1st Review 双门禁（人审 + agent 评审 pipeline）保留。",
        "tags": [
          "bug",
          "default"
        ],
        "gates": [
          "进入 In Dev 需建 workflow 分支",
          "进入评审需关联 MR",
          "1st review 通过才能测试",
          "Review pipeline 通过才能进 Testing",
          "测试通过才能进 2nd review",
          "2nd review 通过才能 Stage",
          "MR 已合并才能进 Done"
        ]
      }
    ]
  }
}