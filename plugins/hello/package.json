{
  "name": "dsh-plugins-hello",
  "version": "0.1.0",
  "description": "DSH hello world 插件 bundle：注册 hello 模型工具，演示官方 bundle 包规范（dsh.bundle + cordis.patch.yml）",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "hello-world"
  ],
  "license": "MIT"
}
