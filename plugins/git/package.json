{
  "name": "dsh-git",
  "version": "0.1.0",
  "private": true,
  "description": "DSH git 插件：task 关联 GitHub/本地仓库/branch/MR，跨插件同步与 [ID] 自动关联",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit 2>/dev/null || true",
    "check": "node build.mjs && node scripts/verify-dist.mjs",
    "publish:git": "npm run check && npm publish",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@dsh-plugins/ui": "workspace:*",
    "@dsh-plugins/communication": "workspace:*",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "PLAN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "git",
    "deepseek-harness"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@dsh-plugins/communication": "workspace:*"
  }
}
