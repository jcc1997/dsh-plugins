{
  "name": "dsh-pipeline",
  "version": "0.1.0",
  "description": "DSH Pipeline 流水线插件（正式 bundle 形态）：可复用节点组合、版本化发布（npm 风格 semver）、运行队列与进度监控",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node build.mjs && node scripts/verify-dist.mjs",
    "publish:pipeline": "npm run check && npm publish",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@dsh-plugins/ui": "workspace:*",
    "@types/react": "^18.3.0",
    "@xyflow/react": "^12.11.3",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pipeline",
    "workflow",
    "deepseek-harness",
    "cordis"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
