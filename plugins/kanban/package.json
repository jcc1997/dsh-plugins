{
  "name": "dsh-kanban-plugin",
  "version": "0.2.0",
  "description": "DSH 看板插件（bundle 化部署目标）：归档/侧边栏/分组/富文本内容（v3）",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node build.mjs && node scripts/verify-dist.mjs",
    "publish:kanban": "npm run check && npm publish"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "@dsh-plugins/ui": "workspace:*"
  },
  "files": [
    "dist",
    "src",
    "build.mjs",
    "shims",
    "scripts",
    "README.md",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "kanban",
    "deepseek-harness"
  ]
}
